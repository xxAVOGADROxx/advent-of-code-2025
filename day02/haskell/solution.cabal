cabal-version:      3.0
name:               solution
version:            0.1.0.0
synopsis:           AoC 2025 day solution (Haskell)
author:             Jose Seraquive
maintainer:         jose.seraquive@gmail.com
build-type:         Simple

executable solution
    main-is:          Solution.hs
    build-depends:    base         ^>=4.18
                    , containers
                    , text
                    , bytestring
                    , split
                    , vector
    default-language: Haskell2010
    ghc-options:      -O2 -Wall -Wno-unused-imports -Wno-unused-top-binds
