#!/usr/bin/env bash
# AoC 2025 polyglot runner (python, haskell, rust, typescript, nix).
#   ./compile --day N       --lang python|haskell|rust|typescript|nix
#   ./compile --day N       --all
#   ./compile --day N       --benchmark [--lang X]
#   ./compile --example NAM --lang X   (usa examples/NAM/ + examples/NAM/input.txt)
#   ./compile --example NAM --all
#   ./compile new-day N

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# Cargar toolchains si no están en PATH (login shells / .bashrc pueden no correr).
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# nvm vive en ~/.nvm por defecto, pero también es común ~/.config/nvm (XDG).
for _nvm_dir in "${NVM_DIR:-}" "$HOME/.nvm" "$HOME/.config/nvm"; do
  [ -n "$_nvm_dir" ] && [ -s "$_nvm_dir/nvm.sh" ] && { . "$_nvm_dir/nvm.sh" >/dev/null 2>&1; break; }
done
[ -d "$HOME/.ghcup/bin" ] && export PATH="$HOME/.ghcup/bin:$PATH"
[ -s "$HOME/.nix-profile/etc/profile.d/nix.sh" ] && . "$HOME/.nix-profile/etc/profile.d/nix.sh"
# ~/.local/bin es donde viven gh, pyright, ruff, poetry, pytest, nix-portable
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

ALL_LANGS=(python haskell rust cpp typescript nix)

# Detecta nix nativo o nix-portable (single-static-binary, no requiere /nix ni root).
nix_cmd() {
  if command -v nix-instantiate >/dev/null 2>&1; then
    echo ""    # está en PATH, invocación directa
  elif command -v nix-portable >/dev/null 2>&1; then
    echo "nix-portable"
  else
    echo "✗ ni nix-instantiate ni nix-portable en PATH" >&2
    return 1
  fi
}

# --- lang aliases ---------------------------------------------------------
normalize_lang() {
  case "$1" in
    py|python)     echo python ;;
    hs|haskell)    echo haskell ;;
    rs|rust)       echo rust ;;
    cpp|c++|cc|cxx) echo cpp ;;
    ts|typescript) echo typescript ;;
    nix)           echo nix ;;
    *) echo "unknown lang: $1" >&2; exit 2 ;;
  esac
}

# --- run one lang inside a target dir ------------------------------------
# args: <base_dir> <lang> <input_file>
run_lang() {
  local base="$1" lang="$2" input="$3"
  local dir="$base/$lang"

  if [ ! -d "$dir" ]; then
    echo "✗ $dir no existe" >&2; return 1
  fi
  if [ ! -f "$input" ]; then
    echo "⚠ $input no existe — pasando input vacío (STDIN cerrado)" >&2
    input=/dev/null
  fi

  case "$lang" in
    python)
      python3 "$dir/solution.py" < "$input"
      ;;
    haskell)
      (cd "$dir" && cabal build -v0 solution) >&2
      local bin; bin="$(cd "$dir" && cabal list-bin -v0 solution)"
      "$bin" < "$input"
      ;;
    rust)
      (cd "$dir" && cargo build --release --quiet)
      "$dir/target/release/solution" < "$input"
      ;;
    cpp)
      # Rebuild solo si el fuente cambió — así --benchmark mide el binario, no g++.
      local cpp_bin="$dir/build/solution"
      mkdir -p "$dir/build"
      if [ ! -x "$cpp_bin" ] || [ "$dir/solution.cpp" -nt "$cpp_bin" ]; then
        g++ -std=c++20 -O2 -o "$cpp_bin" "$dir/solution.cpp" >&2
      fi
      "$cpp_bin" < "$input"
      ;;
    typescript)
      (cd "$dir" && npx --yes tsx solution.ts) < "$input"
      ;;
    nix)
      # Nix no tiene stdin — pasamos el input path como argumento.
      # `--json` envuelve el string en JSON; `jq -r` lo desempaqueta a texto crudo.
      local abs_input; abs_input="$(readlink -f "$input")"
      local NIX; NIX="$(nix_cmd)"
      (cd "$dir" && $NIX nix-instantiate --eval --strict \
        --argstr inputPath "$abs_input" --json solution.nix) | jq -r .
      ;;
  esac
}

# --- benchmark: usa hyperfine si está, si no `time` ----------------------
# args: <base_dir> <input_file> <lang>...
benchmark() {
  local base="$1" input="$2"; shift 2
  local langs=("$@")

  for lang in "${langs[@]}"; do
    echo "→ pre-build $lang"
    run_lang "$base" "$lang" "$input" > /dev/null 2>&1 || true
  done

  local abs_input; abs_input="$(readlink -f "$input")"

  if command -v hyperfine >/dev/null; then
    local cmds=()
    for lang in "${langs[@]}"; do
      case "$lang" in
        python)     cmds+=("--command-name" "python"     "python3 $base/python/solution.py < $abs_input") ;;
        haskell)
          local hs_bin; hs_bin="$(cd "$base/haskell" && cabal list-bin -v0 solution)"
          cmds+=("--command-name" "haskell" "$hs_bin < $abs_input") ;;
        rust)       cmds+=("--command-name" "rust"       "$base/rust/target/release/solution < $abs_input") ;;
        cpp)        cmds+=("--command-name" "cpp"        "$base/cpp/build/solution < $abs_input") ;;
        typescript) cmds+=("--command-name" "typescript" "npx --yes tsx $base/typescript/solution.ts < $abs_input") ;;
        nix)
          local NIX; NIX="$(nix_cmd)"
          cmds+=("--command-name" "nix" "$NIX nix-instantiate --eval --strict --argstr inputPath $abs_input --json $base/nix/solution.nix | jq -r .") ;;
      esac
    done
    hyperfine --warmup 2 --shell=bash "${cmds[@]}"
  else
    echo "hyperfine no encontrado — usando 'time' (menos preciso)"
    echo "Instala con: cargo install hyperfine"
    for lang in "${langs[@]}"; do
      echo "--- $lang ---"
      { time run_lang "$base" "$lang" "$input" >/dev/null ; } 2>&1 | grep real
    done
  fi
}

# --- new-day: copia template ---------------------------------------------
new_day() {
  local day="$1"
  local dir; dir="$(printf "day%02d" "$day")"
  if [ -d "$dir" ]; then
    echo "✗ $dir ya existe" >&2; exit 1
  fi
  cp -r template "$dir"
  sed -i "s/\"aoc-template\"/\"aoc-$(printf "day%02d" "$day")\"/" "$dir/typescript/package.json" || true
  touch "$(printf "inputs/day%02d.txt" "$day")"
  echo "✓ $dir listo. Pega tu input en $(printf "inputs/day%02d.txt" "$day")"
}

# --- CLI ------------------------------------------------------------------
usage() { sed -n '2,10p' "$0" | sed 's/^# //'; }

[ $# -eq 0 ] && { usage; exit 0; }

if [ "$1" = "new-day" ]; then
  [ -z "${2:-}" ] && { echo "uso: $0 new-day N"; exit 2; }
  new_day "$2"; exit 0
fi

DAY=""
EXAMPLE=""
LANG=""
ALL=false
BENCH=false

while [ $# -gt 0 ]; do
  case "$1" in
    --day)       DAY="$2"; shift 2 ;;
    --example)   EXAMPLE="$2"; shift 2 ;;
    --lang)      LANG="$(normalize_lang "$2")"; shift 2 ;;
    --all)       ALL=true; shift ;;
    --benchmark) BENCH=true; shift ;;
    -h|--help)   usage; exit 0 ;;
    *) echo "flag desconocida: $1" >&2; exit 2 ;;
  esac
done

# resolver base + input
if [ -n "$EXAMPLE" ]; then
  BASE="examples/$EXAMPLE"
  INPUT="examples/$EXAMPLE/input.txt"
  [ -d "$BASE" ] || { echo "✗ $BASE no existe" >&2; exit 1; }
elif [ -n "$DAY" ]; then
  BASE="$(printf "day%02d" "$DAY")"
  INPUT="$(printf "inputs/day%02d.txt" "$DAY")"
else
  echo "falta --day N o --example NAME" >&2; exit 2
fi

if $BENCH; then
  if $ALL || [ -z "$LANG" ]; then
    benchmark "$BASE" "$INPUT" "${ALL_LANGS[@]}"
  else
    benchmark "$BASE" "$INPUT" "$LANG"
  fi
  exit 0
fi

if $ALL; then
  for lang in "${ALL_LANGS[@]}"; do
    echo "═══ $lang ═══"
    run_lang "$BASE" "$lang" "$INPUT" || true
    echo
  done
else
  [ -z "$LANG" ] && { echo "falta --lang X (o usa --all)" >&2; exit 2; }
  run_lang "$BASE" "$LANG" "$INPUT"
fi
